{
  "name": "mhm-97-remake",
  "version": "2.0.0",
  "description": "A remake of MHM 97",
  "main": "src",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "oxlint -c oxlintrc.json .",
    "format": "oxfmt -c .oxfmt.json . --write",
    "format:check": "oxfmt -c .oxfmt.json . --check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pekkis/react-training-broilerplate"
  },
  "keywords": [
    "MHM 97",
    "remake"
  ],
  "author": "Pekkis",
  "license": "MIT",
  "jest": {
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css)$": "<rootDir>/__mocks__/styleMock.js",
      "\\.(pcss)$": "identity-obj-proxy"
    }
  },
  "dependencies": {
    "@emotion/core": "^11.0.0",
